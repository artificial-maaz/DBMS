# Copy to .env and fill in. NEVER commit .env (already gitignored).

# PostgreSQL connection string (local dev example; use Neon/Supabase URL in cloud)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dealership_erp

# Better Auth — generate secret with: npx @better-auth/cli secret
BETTER_AUTH_SECRET=replace-me
BETTER_AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# EMAIL — SMTP is the transport in use (2026-08-15). Filled in, it wins over
# Resend below. Sends from a mailbox we already own, so it can deliver to
# anyone with no domain and no DNS.
#
# Gmail setup: 2-Step Verification ON -> Google Account -> Security ->
# App passwords -> generate, name it "Hussain Motors ERP". 16 characters.
# That is NOT the account password; it only permits sending and can be revoked
# from the same screen without affecting the mailbox.
# ---------------------------------------------------------------------------
SMTP_USER=yadeahussainautos@gmail.com
SMTP_PASS=
SMTP_FROM=Yadea Hussain Motors <yadeahussainautos@gmail.com>
# Optional; defaults are Gmail's.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Added to the recipients of EVERY email. The official company mailbox, which
# every owner is already signed into on their own device — one address reaches
# all of them, and no personal address ends up baked into the system.
MAIL_ALWAYS_CC=yadeahussainautos@gmail.com

# ---------------------------------------------------------------------------
# Fallback transport, unused while SMTP is configured. Becomes the better
# option once a domain is owned and verified.
# ---------------------------------------------------------------------------
# Email (resend.com free account -> API key). Until a domain is verified there,
# Resend only delivers to the account owner's own email address — and it rejects
# the whole send if ANY recipient is someone else.
RESEND_API_KEY=

# While no domain is verified: redirect EVERY email to this one address.
# The email still names who it was really meant for. Delete this line once a
# domain is verified on Resend and real recipients start receiving automatically.
RESEND_ONLY_TO=

# Optional: custom sender, only valid once you own a verified domain.
# e.g. "Hussain Motors ERP <erp@yourdomain.com>". Defaults to Resend's shared sender.
RESEND_FROM=

# Shared secret protecting /api/cron/daily, /api/cron/monthly and /api/cron/digest
CRON_SECRET=replace-me
